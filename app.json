{
  "expo": {
    "name": "GreenMind",
    "slug": "greenmind",
    "owner": "ashleystars",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-flat.png",
    "scheme": "greenmind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDkmrjp6MjyKqv8dZVG_IlQURzcZX8W5Dc"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon-flat.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ashleystars.greenmind",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDkmrjp6MjyKqv8dZVG_IlQURzcZX8W5Dc"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/icon-flat.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/icon-flat.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af7faf92-ba85-4c1e-9f5e-0bcfeaa6bd31"
      }
    }
  }
}
